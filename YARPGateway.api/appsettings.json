{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "UserService",
    "Audience": "UserServiceClient",
    "ExpiryMinutes": 10,
    "Key": "cVY2aVg1S2l6T2JQNmJwRjR3bXFjT0N5b1p4d2pGdjR5ZVJwN1hSa3I5aA=="
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "basket-route": {
        "ClusterId": "basket-cluster",
        "Match": {
          "Path": "/basket/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/basket"
          }
        ],
        "RateLimiterPolicy": "fixed"
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/catalog"
          }
        ],
        "RateLimiterPolicy": "fixed"
      },
      "ordering-route": {
        "ClusterId": "ordering-cluster",
        "Match": {
          "Path": "/ordering/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/ordering"
          }
        ],
        "RateLimiterPolicy": "fixed"
      },
      "discount-route": {
        "ClusterId": "discount-cluster",
        "Match": {
          "Path": "/discount/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/discount"
          }
        ],
        "RateLimiterPolicy": "fixed"
      },
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/users/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/users"
          }
        ],
        "RateLimiterPolicy": "fixed"
      }
    },
    "Clusters": {
      "basket-cluster": {
        "Destinations": {
          "basket-destination": {
            "Address": "http://basket.api:8080/"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog-destination": {
            "Address": "http://catalog.api:8080/"
          }
        }
      },
      "ordering-cluster": {
        "Destinations": {
          "ordering-destination": {
            "Address": "http://ordering.api:8080/"
          }
        }
      },
      "discount-cluster": {
        "Destinations": {
          "discount-destination": {
            "Address": "http://discount.grpc:8080/"
          }
        }
      },
      "users-cluster": {
        "Destinations": {
          "users-destination": {
            "Address": "http://users.api:8080/"
          }
        }
      }
    }
  }
}
